<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<PropertyGroup>

<EngineIncludeRoot>$(MSBuildThisFileDirectory)</EngineIncludeRoot>

<ExtensionIncludeRoot>$(EngineIncludeRoot)..\Extension\</ExtensionIncludeRoot>

<DxcRoot>$(ExtensionIncludeRoot)DXC\</DxcRoot>

<EngineCommonHeaderDirectories>$([System.IO.Directory]::GetDirectories('$(EngineIncludeRoot)EngineCommonHeader', '*', System.IO.SearchOption.AllDirectories))</EngineCommonHeaderDirectories>

<EngineManagerDirectories>$([System.IO.Directory]::GetDirectories('$(EngineIncludeRoot)EngineManager', '*', System.IO.SearchOption.AllDirectories))</EngineManagerDirectories>

<EngineEditorDirectories>$([System.IO.Directory]::GetDirectories('$(EngineIncludeRoot)EngineEditor', '*', System.IO.SearchOption.AllDirectories))</EngineEditorDirectories>

<EngineResourceDirectories>$([System.IO.Directory]::GetDirectories('$(EngineIncludeRoot)EngineResource', '*', System.IO.SearchOption.AllDirectories))</EngineResourceDirectories>

<EngineObjectDirectories>$([System.IO.Directory]::GetDirectories('$(EngineIncludeRoot)EngineObject', '*', System.IO.SearchOption.AllDirectories))</EngineObjectDirectories>

<EngineShaderDirectories>$([System.IO.Directory]::GetDirectories('$(EngineIncludeRoot)EngineShader', '*', System.IO.SearchOption.AllDirectories))</EngineShaderDirectories>

<EngineHeaderDirectories>
      	$(EngineIncludeRoot);
      	$(EngineIncludeRoot)EngineCommonHeader;
      	$(EngineIncludeRoot)EngineManager;
      	$(EngineIncludeRoot)EngineEditor;
      	$(EngineIncludeRoot)EngineResource;
      	$(EngineIncludeRoot)EngineObject;
      	$(EngineIncludeRoot)EngineShader;

	$(EngineCommonHeaderDirectories);
      	$(EngineManagerDirectories);
      	$(EngineEditorDirectories);
      	$(EngineResourceDirectories);
	$(EngineObjectDirectories)
	$(EngineShaderDirectories)

</EngineHeaderDirectories>

<EngineDependencyDirectories>
      	$(ExtensionIncludeRoot);
      	$(ExtensionIncludeRoot)Include;
	$(ExtensionIncludeRoot)DirectXHeader;
      	$(ExtensionIncludeRoot)GameInput\native\include;
      	$(DxcRoot)inc
</EngineDependencyDirectories>

</PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(EngineHeaderDirectories);$(EngineDependencyDirectories);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'GameEngine' And '$(Platform)' == 'x64'">
    <Link>
      <AdditionalLibraryDirectories>$(DxcRoot)lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>dxcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

<Import Project="$(MSBuildThisFileDirectory)GameEngine.AdditionalLibraries.props" Condition="'$(MSBuildProjectName)' == 'GameEngine'" />

</Project>